generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum UserRole {
 STUDENT
 ADMIN
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String
  role		       UserRole @default(STUDENT)
  failedLoginAttempts  Int      @default(0)
  lockedUntil          DateTime?
  twoFactorCode        String?
  twoFactorExpires     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  studentRecord StudentRecord?

  @@map("users")
}

model StudentRecord {
  id           String   @id @default(uuid())
  studentNumber String  @unique
  name         String
  programCode  String?
  programTitle String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])

  degreeAudits DegreeAudit[]

  @@map("student_records")
}

model DegreeAudit {
  id                  String        @id @default(uuid())
  studentRecordId     String
  studentRecord       StudentRecord @relation(fields: [studentRecordId], references: [id])

  sourceAuditSequence String?       @unique
  sourceJobId         String?
  programCode         String
  programTitle        String
  runDate             DateTime
  requirements DegreeRequirement[]

  createdAt           DateTime      @default(now())

  @@index([studentRecordId, runDate])
  @@map("degree_audits")
}


model DegreeRequirement {
  id               String   @id @default(uuid())
  degreeAuditId    String
  degreeAudit      DegreeAudit @relation(fields: [degreeAuditId], references: [id], onDelete: Cascade)

  sourceRtabx      String
  sourceName       String?
  title            String?
  satisfiedCode    String?
  sourceData       Json?

  subrequirements  DegreeSubrequirement[]

  @@unique([degreeAuditId, sourceRtabx])
  @@map("degree_requirements")
}

model DegreeSubrequirement {
  id               String @id @default(uuid())
  requirementId    String
  requirement      DegreeRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  sourceStabx      String
  sourceSubreqId   String?
  title            String?
  satisfiedCode    String?
  sourceData       Json?
  courses              AuditCourse[]
  allowableCourseRules AllowedCourseRule[]

  @@unique([requirementId, sourceStabx])
  @@map("degree_subrequirements")
}


model AuditCourse {
  id                String @id @default(uuid())
  subrequirementId  String
  subrequirement    DegreeSubrequirement @relation(fields: [subrequirementId], references: [id], onDelete: Cascade)

  sourceIntSeqNo    String
  courseCode        String
  courseTitle       String?
  termCode          String?
  grade             String?
  credits           Decimal? @db.Decimal(10, 5)
  inProgressCode    String?
  sourceData        Json?

  @@unique([subrequirementId, sourceIntSeqNo])
  @@index([courseCode])
  @@map("audit_courses")
}

model AllowedCourseRule {
  id               String @id @default(uuid())
  subrequirementId String
  subrequirement   DegreeSubrequirement @relation(fields: [subrequirementId], references: [id], onDelete: Cascade)

  sourceIntSeqNo   String
  coursePattern   String?
  ruleType        String?
  sourceData      Json?

  @@unique([subrequirementId, sourceIntSeqNo])
  @@map("allowed_course_rules")
}